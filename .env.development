# -----------------------
# 🌍 ORTAM KONFİGÜRASYONU
# -----------------------
APP_ENV=development
DOCKERIZED=false

# -----------------------
# 🏗️ UYGULAMA AYARLARI
# -----------------------
APP_NAME=TakipSistemi
APP_HOST=127.0.0.1
APP_PORT=8000
API_PREFIX=/api/v1
DEBUG=true
STATIC_FILES_DIR=./static
CSRF_PROTECTION=false

# -----------------------
# 📚 API DOKÜMANTASYONU
# -----------------------
DOCS_URL=/docs
REDOC_URL=/redoc

# -----------------------
# 🔒 GÜVENLİK & KİMLİK DOĞRULAMA
# -----------------------
SECRET_KEY=this-is-my-super-secret-key-for-dev-env-123!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=TakipSistemi
JWT_AUDIENCE=TakipSistemiUsers

# -----------------------
# 🌐 CORS AYARLARI
# -----------------------
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000"]


# -----------------------
# 🗄️ MONGODB KONFİGÜRASYONU
# -----------------------
MONGO_URI=mongodb://takip_user:StrongPass123!@mongodb:27017/takip_prod
MONGO_DB_NAME=takip_prod
MONGO_USER=takip_user
MONGO_PASSWORD=StrongPass123!
MONGO_MAX_POOL_SIZE=20
MONGO_INITDB_TRANSACTION_TIMEOUT=30000
MONGO_INITDB_MAX_RETRIES=5
# MongoDB Root/Admin Kullanıcısı
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
# -----------------------
# ⚡ UVICORN SUNUCU AYARLARI
# -----------------------
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=1
UVICORN_RELOAD=true

# -----------------------
# 🔌 DIŞ SERVİS ENTEGRASYONLARI
# -----------------------
REDIS_HOST=redis
RABBITMQ_HOST=rabbitmq

# -----------------------
# 📝 LOGLAMA KONFİGÜRASYONU
# -----------------------
LOG_LEVEL=DEBUG
LOG_FILE=./logs/app.log
LOG_ROTATION=10MB
