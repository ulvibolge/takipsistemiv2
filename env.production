APP_ENV=production
DEBUG=false
DOCS_URL=
REDOC_URL=
MONGO_URI=mongodb://prod_user:prod_pass@mongo:27017/takip_db?authSource=admin&retryWrites=true&w=majority
MONGO_USER=prod_user
MONGO_PASSWORD=prod_pass
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=rootprod
REQUIRE_SSL=true
HSTS_ENABLE=true
HSTS_MAX_AGE=31536000
ADMIN_ALERT_EMAILS=admin@takipsistemi.com

# ----- UYGULAMA BİLGİLERİ -----
APP_NAME=TakipSistemi
API_PREFIX=/api/v1
APP_TITLE=Takip Sistemi API
APP_DESCRIPTION=Çoklu firma destekli proje takip sistemi
APP_VERSION=1.0.0

# ----- ZAMAN / LOKALİZASYON -----
DEFAULT_TIMEZONE=Europe/Istanbul

# ----- JWT / GÜVENLİK -----
SECRET_KEY=change-this-secret-key-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TIMEOUT_MINUTES=15
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_TIME_MINUTES=30
SESSION_TIMEOUT_MINUTES=30
CSRF_PROTECTION=true

# ----- VERİTABANI -----
MONGO_DB_NAME=takip_db
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=30000

# ----- FASTAPI UVICORN -----
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=1
UVICORN_RELOAD=false
UVICORN_PROXY_HEADERS=true
UVICORN_KEEP_ALIVE=60

# ----- LOGGING -----
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/app.log
LOG_ROTATION=10MB
LOG_RETENTION=30

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- RATE LIMITING -----
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_AUTH_ENDPOINTS=20

# ----- STATİK DOSYALAR -----
STATIC_FILES_DIR=./static

# ----- EMAIL / SMTP -----
SMTP_SERVER=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=testuser
SMTP_PASSWORD=testpass
EMAIL_FROM=no-reply@takipsistemi.com
EMAIL_USE_TLS=true

# ----- UPLOAD KLASÖRÜ -----
UPLOAD_DIR=./uploads

# ----- BACKUP -----
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=7

# ----- MONITORING / SENTRY -----
MONITORING_ENABLED=true
SENTRY_DSN=
HEALTH_CHECK_INTERVAL=300
PROMETHEUS_PORT=9090

# ----- DIŞ SERVİS -----
SLACK_WEBHOOK_URL=